<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>ArpRecorder</AssemblyName>
    <RootNamespace>Arp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>

    <!-- Windowed app; the diagnostic switches write to a console only when one
         is already attached. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>

    <!-- Size levers. There is no framework dependency and no NuGet package:
         every bit of interop is hand-written, which is what lets this link
         under NativeAOT at a few megabytes. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <StackTraceSupport>true</StackTraceSupport>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- The NVDA controller client must match the architecture of THIS process,
       not NVDA's. Drop the matching client into native\<rid>\ and it ships
       beside the exe; if it is absent, speech falls back to SAPI. -->
  <ItemGroup>
    <None Include="native\$(RuntimeIdentifier)\*.dll"
          Condition="'$(RuntimeIdentifier)' != ''"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
    <!-- The controller client is LGPL, so its licence ships with it. -->
    <None Include="native\NVDA-controllerClient-LICENSE.txt"
          Condition="'$(RuntimeIdentifier)' != ''"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
