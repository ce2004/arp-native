<Window x:Class="AudioRecorderPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accessible Advanced Audio Recorder" Height="300" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Audio Recorder Dashboard" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button x:Name="BtnExit" Content="E_xit" MinHeight="40" MinWidth="100" Margin="0,0,10,0" Click="BtnExit_Click"/>
            <Button x:Name="BtnSettings" Content="Se_ttings" MinHeight="40" MinWidth="100" Margin="0,0,10,0" Click="BtnSettings_Click"/>
            <Button x:Name="BtnToggleRecord" Content="_Start Recording" MinHeight="40" MinWidth="120" Margin="0,0,10,0" Click="BtnToggleRecord_Click"/>
            <Button x:Name="BtnPause" Content="_Pause" MinHeight="40" MinWidth="100" IsEnabled="False" Click="BtnPause_Click"/>
        </StackPanel>
        
        <TextBlock x:Name="OverviewLbl" Grid.Row="2" TextWrapping="Wrap" Margin="0,15,0,15" Focusable="True">
            Recording Device is set to: None Selected (Will use default)<LineBreak/>
            Output Folder is set to: Unknown<LineBreak/>
            Auto-Recording is: Off<LineBreak/>
            Auto-Split is: Off<LineBreak/>
            <LineBreak/>
            Status: Ready
        </TextBlock>
        
        <Border Grid.Row="3" Background="#e0e0e0" CornerRadius="5" Padding="10" x:Name="LiveStatsBorder" Visibility="Collapsed">
            <TextBlock x:Name="LiveStatsLbl" FontWeight="Bold" HorizontalAlignment="Center" Focusable="True" Text="Recording time, 0 seconds. 0.00 MB Storage used."/>
        </Border>
    </Grid>
</Window>
